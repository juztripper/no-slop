# Your own key, used only by your detector. Provider usage is billed to your account.
# Never put provider credentials in extension settings or browser bundles.
OPENROUTER_API_KEY=your-openrouter-key
HOST=127.0.0.1
PORT=8787
JEV_MODEL=~typesafe/jev-latest
# Set an access token when hosting beyond your computer; enter it in extension settings.
SERVICE_TOKEN=
# For Docker or remote hosting, set your exact chrome-extension://<id> origin.
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=40
MAX_CONCURRENT=4
MAX_PENDING=32
DAILY_CALL_BUDGET=10000
# This is a call-count limit, not a currency limit. Set a provider key spending cap too.
BUDGET_FILE=.data/budget.json
CACHE_MAX_ENTRIES=2000
CACHE_TTL_SECONDS=1800
# Set only the actual reverse proxy IP/CIDR, never a wildcard.
TRUST_PROXY=
