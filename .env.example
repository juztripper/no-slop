# Server only. Never put provider credentials in extension settings or browser bundles.
OPENROUTER_API_KEY=your-openrouter-key
HOST=127.0.0.1
PORT=8787
JEV_MODEL=~typesafe/jev-latest
VISION_MODEL=google/gemini-2.5-flash-lite
# Set an access token for private deployments. Public extension tokens are not secrets.
SERVICE_TOKEN=
# For public deployment, set the exact released extension origin.
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=40
MAX_CONCURRENT=4
MAX_PENDING=32
DAILY_CALL_BUDGET=10000
BUDGET_FILE=.data/budget.json
CACHE_MAX_ENTRIES=2000
CACHE_TTL_SECONDS=1800
# Set only the actual reverse proxy IP/CIDR, never a wildcard.
TRUST_PROXY=
