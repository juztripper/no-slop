{
  "name": "no-slop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open-source browser extension that makes room for worthwhile content.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:dev": "tsx --env-file=.env server/index.ts",
    "server:build": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "server:start": "node --env-file=.env dist-server/index.js",
    "check": "npm run typecheck && npm test && npm run build && npm run server:build",
    "eval:live": "tsx --env-file=.env scripts/evaluate.ts",
    "eval:holdout": "tsx --env-file=.env scripts/evaluate-holdout.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/themes": "^3.3.0",
    "fastify": "^5.6.1",
    "ipaddr.js": "^2.2.0",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "undici": "^7.16.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.24",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.10",
    "jsdom": "^27.0.0",
    "sharp": "^0.35.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.11"
  }
}
